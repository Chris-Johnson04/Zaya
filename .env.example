# Copier ce fichier vers .env.local puis remplir les vraies valeurs.
# Ne jamais committer de vraies clés.

# Ces deux valeurs sont PUBLIQUES : la sécurité repose sur la RLS dans la base.
VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-anon-publique

# INTERDIT côté frontend : service_role key, clés de paiement, clés privées.
